<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
    <?xml-stylesheet type="text/css" href="#style"?>
    <extra id="style">
        .panel {
            side:top;
            fill:both;
            expand:yes;
        }
        .row {
            side:top;
            fill:x;
        }
        .column {
            side:left;
            fill:y;
        }
    </extra>
    <category label="Category uno">
        <label class="row" name="fpath" text="text" font="Helvetica 32 bold" bg="#919F84"/>  
        <collapsingframe class="panel" lib="mywidgets.Widgets.Custom" name="vframe" orientation="vertical" inisplit="0.2" buttconf="RmM">
            <widgetexplorer class="panel" lib="mywidgets.Widgets.Custom" name="filetree"
                        show="tree"
                        selectmode="browse"
                        in=".frstwidget"
            />
            <frame class="panel" in=".scndwidget">
                <rgxpatbar class="row" name="regexBar" lib="mywidgets.Widgets.Custom" messageVar="messsageVar" side="top" fill="x"/>
                <collapsingframe class="panel" lib="mywidgets.Widgets.Custom" name="hframe" orientation="horizontal" inisplit="0.8" buttconf="RmM">
                    <rgxeditor class="panel" name="txtEditor" lib="mywidgets.Widgets.Custom" in=".frstwidget"/>
                    <rgxtreelist class="panel" name="tree" lib="mywidgets.Widgets.Custom" in=".scndwidget" displaycolumns="#all" show="headings" columns="posINI posFIN var0 var1 var2 var3 var4 var5 var6 var7 var8 var9"/>
                </collapsingframe>
            </frame>
            <rgxstatusbar class="row" name="statusBar" lib="mywidgets.Widgets.Custom" statusList="Message" side="bottom"/>                
        </collapsingframe>
    </category>
</settings>

